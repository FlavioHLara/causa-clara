# Convenções de formatação comuns ao repositório.
# EnforceCodeStyleInBuild está ligado no Directory.Build.props, então o que
# estiver marcado como warning aqui vira erro de compilação no backend.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs,csx}]
indent_size = 4

# ---------- C# ----------
[*.cs]
# Organização de usings
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace:warning

# Declaração de namespace em uma linha: menos uma indentação em todo arquivo
csharp_style_namespace_declarations = file_scoped:warning

# Imutabilidade por padrão. O domínio depende disso: propriedade com atribuidor
# público é como a regra RN01 seria furada sem ninguém perceber.
dotnet_style_readonly_field = true:warning
csharp_prefer_static_local_function = true:warning
csharp_style_prefer_readonly_struct = true:suggestion

# var só quando o tipo é evidente na própria linha
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Expressões modernas
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_throw_expression = true:suggestion

# Chaves sempre, mesmo em bloco de uma linha
csharp_prefer_braces = true:suggestion

# Nomes
dotnet_naming_rule.tipos_em_pascal_case.severity = warning
dotnet_naming_rule.tipos_em_pascal_case.symbols = tipos
dotnet_naming_rule.tipos_em_pascal_case.style = pascal_case
dotnet_naming_symbols.tipos.applicable_kinds = class,struct,interface,enum,delegate
dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_naming_rule.campos_privados_com_underscore.severity = suggestion
dotnet_naming_rule.campos_privados_com_underscore.symbols = campos_privados
dotnet_naming_rule.campos_privados_com_underscore.style = prefixo_underscore
dotnet_naming_symbols.campos_privados.applicable_kinds = field
dotnet_naming_symbols.campos_privados.applicable_accessibilities = private
dotnet_naming_style.prefixo_underscore.required_prefix = _
dotnet_naming_style.prefixo_underscore.capitalization = camel_case

# ---------- Arquivos gerados ----------
# Migrações são geradas pelo EF; não vale impor estilo sobre elas.
[**/Migrations/*.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none

# ---------- Web ----------
[*.{ts,tsx,js,jsx,json,css,html,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{sln,slnx,csproj,props,targets}]
indent_size = 2
end_of_line = crlf
